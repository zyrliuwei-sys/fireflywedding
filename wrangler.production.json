{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fireflywedding",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://fireflywedding.org",
    "VITE_APP_NAME": "Firefly Wedding",
    "VITE_APP_DESCRIPTION": "Unofficial Firefly Wedding (Hotaru no Yomeiri) fan hub: where to watch, story, characters and latest news.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fireflywedding",
      "database_id": "26218e7f-3d33-4602-98c2-b657a35a51d6",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "routes": [{ "pattern": "fireflywedding.org", "custom_domain": true }]
}
